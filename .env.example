DATABASE_URL=postgres://localhost:5433/kayan_dev
SESSION_SECRET=change-me-long-random-string
PORT=3000
# Bootstrap the first (original) admin on first run of `npm run seed`
ADMIN_EMAIL=admin@kayan.local
ADMIN_PASSWORD=change-me
# Automation: run in-process scheduler (true on a long-running host, false on serverless)
RUN_CRON=true
# Secret that protects the external cron endpoint POST /api/cron/run
CRON_SECRET=change-me
# Optional SMTP for sending invite emails (if empty, admin copies the invite link manually)
SMTP_URL=
# WhatsApp ingestion adapter: mock | webhook (real WhatsApp connection comes later)
WHATSAPP_ADAPTER=mock
WHATSAPP_WEBHOOK_SECRET=change-me
# Optional external AI provider for the staff assistant (falls back to built-in data assistant)
AI_API_KEY=
AI_API_URL=
