<%- include('../partials/top', {title, nav:'commissions'}) %>
<% const STATUS = { pending: 'معلّقة', approved: 'معتمدة', paid: 'مدفوعة', cancelled: 'ملغاة' }; %>
<div class="card">
  <h2>قاعدة احتساب العمولة</h2>
  <% if (rule) { %>
    <p class="muted">القاعدة الحالية: <b><%= basisLabels[rule.basis] %></b><% if (rule.basis === 'fixed') { %> — <%= Number(rule.fixed_amount).toLocaleString('ar-EG') %> ج.م<% } else { %> — <%= rule.percent %>٪<% } %></p>
  <% } else { %>
    <p class="alert err">لم تُحدَّد قاعدة بعد. اختر طريقة الاحتساب المعتمدة لديكم ثم اضغط حفظ.</p>
  <% } %>
  <% if (canManage) { %>
  <form method="post" action="/accounting/commissions/rule" class="form mt">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label>طريقة الاحتساب
      <select name="basis" required>
        <% Object.keys(basisLabels).forEach(k => { %>
          <option value="<%= k %>" <%= rawRule.basis === k ? 'selected' : '' %>><%= basisLabels[k] %></option>
        <% }) %>
      </select>
    </label>
    <label>النسبة ٪ (للنسبتين)
      <input type="number" name="percent" step="0.01" min="0" max="100" value="<%= rawRule.percent || '' %>" inputmode="decimal">
    </label>
    <label>المبلغ الثابت ج.م (للمبلغ الثابت)
      <input type="number" name="fixed_amount" step="0.01" min="0" value="<%= rawRule.fixed_amount || '' %>" inputmode="decimal">
    </label>
    <div class="actions"><button class="btn">حفظ القاعدة</button></div>
  </form>
  <form method="post" action="/accounting/commissions/generate" class="mt" onsubmit="return confirm('احتساب/تحديث العمولات المعلّقة لكل الحجوزات المعتمدة؟')">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <button class="btn secondary" <%= rule ? '' : 'disabled' %>>احتساب العمولات الآن</button>
    <p class="muted">يحتسب عمولة لكل حجز معتمد منسوب لموظف مبيعات، ويحدّث المعلّق منها فقط؛ المعتمدة والمدفوعة لا تتغير.</p>
  </form>
  <% } %>
</div>

<div class="card">
  <h2>العمولات</h2>
  <% if (saved) { %><p class="alert ok">تم الحفظ.</p><% } %>
  <div class="grid c3 mt">
    <div class="stat"><div class="num"><%= Number(totals.pending || 0).toLocaleString('ar-EG') %></div><div class="lbl">معلّقة</div></div>
    <div class="stat"><div class="num"><%= Number(totals.approved || 0).toLocaleString('ar-EG') %></div><div class="lbl">معتمدة</div></div>
    <div class="stat"><div class="num"><%= Number(totals.paid || 0).toLocaleString('ar-EG') %></div><div class="lbl">مدفوعة</div></div>
  </div>
  <details class="filters mt" <%= (query.user || query.status) ? 'open data-active' : '' %>>
    <summary class="pill">بحث وتصفية</summary>
    <form method="get" action="/accounting/commissions" class="form mt">
      <label>الموظف
        <select name="user">
          <option value="">الكل</option>
          <% salesUsers.forEach(u => { %><option value="<%= u.id %>" <%= String(query.user || '') === String(u.id) ? 'selected' : '' %>><%= u.name %></option><% }) %>
        </select>
      </label>
      <label>الحالة
        <select name="status">
          <option value="">الكل</option>
          <% Object.keys(STATUS).forEach(s => { %><option value="<%= s %>" <%= query.status === s ? 'selected' : '' %>><%= STATUS[s] %></option><% }) %>
        </select>
      </label>
      <div class="actions"><button class="btn sm">تطبيق</button></div>
    </form>
  </details>
  <table class="mt cards-sm">
    <tr><th>الموظف</th><th>الحجز</th><th>العميل</th><th>الأساس</th><th>المبلغ</th><th>الحالة</th><th></th></tr>
    <% rows.forEach(cm => { %>
    <tr style="<%= cm.status === 'cancelled' ? 'opacity:.55' : '' %>">
      <td><b><%= cm.sales_name %></b></td>
      <td><a href="/orders/<%= cm.order_id %>">#<%= cm.order_id %></a><br><span class="muted"><%= new Date(cm.order_at).toLocaleDateString('ar-EG') %></span></td>
      <td><%= cm.customer_name %></td>
      <td><%= basisLabels[cm.basis] %><br><span class="muted"><%= Number(cm.basis_amount).toLocaleString('ar-EG') %> ج.م<%= cm.rate ? ' × ' + Number(cm.rate) + '٪' : '' %></span></td>
      <td><b><%= Number(cm.amount).toLocaleString('ar-EG') %></b> ج.م</td>
      <td><span class="badge <%= cm.status === 'paid' ? 'green' : (cm.status === 'cancelled' ? 'red' : 'orange') %>"><%= STATUS[cm.status] %></span>
        <% if (cm.note) { %><br><span class="muted"><%= cm.note %></span><% } %></td>
      <td>
        <% if (canManage) { %>
          <% if (cm.status === 'pending') { %>
            <form method="post" action="/accounting/commissions/<%= cm.id %>/approve"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm">اعتماد</button></form>
          <% } else if (cm.status === 'approved') { %>
            <form method="post" action="/accounting/commissions/<%= cm.id %>/pay"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm">صرف</button></form>
          <% } %>
          <% if (cm.status === 'pending' || cm.status === 'approved') { %>
          <details class="mt"><summary class="btn danger sm">إلغاء</summary>
            <form method="post" action="/accounting/commissions/<%= cm.id %>/cancel" class="mt">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <input name="note" placeholder="سبب الإلغاء *" required>
              <button class="btn danger sm mt">تأكيد الإلغاء</button>
            </form>
          </details>
          <% } %>
        <% } %>
      </td>
    </tr>
    <% }) %>
    <% if (!rows.length) { %><tr><td colspan="7" class="muted">لا توجد عمولات بعد.</td></tr><% } %>
  </table>
</div>
<%- include('../partials/bottom') %>
