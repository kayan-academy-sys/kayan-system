<%- include('../partials/top', {title, nav:'accounting'}) %>
<% if (canCreate) { %>
<div class="card">
  <h2>تحويل بين الحسابات</h2>
  <p class="muted">التحويل حركة بين حسابين فقط: لا يُحسب مصروفًا ولا إيرادًا جديدًا.</p>
  <form method="post" action="/accounting/transfers">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="form-row">
      <div><label>من حساب *</label><select name="from_account_id"><% accounts.forEach(a => { %><option value="<%= a.id %>"><%= a.name %></option><% }) %></select></div>
      <div><label>إلى حساب *</label><select name="to_account_id"><% accounts.forEach(a => { %><option value="<%= a.id %>"><%= a.name %></option><% }) %></select></div>
      <div><label>المبلغ *</label><input type="number" step="0.01" min="0.01" name="amount" required></div>
      <div><label>التاريخ *</label><input type="date" name="transfer_date" required></div>
      <div><label>ملاحظات</label><input name="notes"></div>
    </div>
    <button class="btn mt">تسجيل التحويل</button>
  </form>
</div>
<% } %>
<div class="card">
  <h2>سجل التحويلات</h2>
  <table>
    <tr><th>التاريخ</th><th>من</th><th>إلى</th><th>المبلغ</th><th>سجلها</th><th>ملاحظات</th></tr>
    <% rows.forEach(t => { %>
    <tr><td><%= new Date(t.transfer_date).toLocaleDateString('ar-EG') %></td><td><%= t.from_name %></td><td><%= t.to_name %></td>
    <td><b><%= Number(t.amount).toLocaleString('ar-EG') %> ج.م</b></td><td class="muted"><%= t.recorded_by_name || '—' %></td><td class="muted"><%= t.notes || '—' %></td></tr>
    <% }) %>
    <% if (!rows.length) { %><tr><td colspan="6" class="muted">لا توجد تحويلات.</td></tr><% } %>
  </table>
</div>
<%- include('../partials/bottom') %>
