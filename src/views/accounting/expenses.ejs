<%- include('../partials/top', {title, nav:'expenses'}) %>
<div class="grid c2">
  <div class="card">
    <h2>تسجيل مصروف</h2>
    <form method="post" action="/accounting/expenses">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="form-row">
        <div><label>النوع *</label><select name="type_id"><% types.forEach(t => { %><option value="<%= t.id %>"><%= t.name %></option><% }) %></select></div>
        <div><label>القيمة (ج.م) *</label><input type="number" step="0.01" min="0.01" name="amount" required></div>
      </div>
      <div class="form-row">
        <div><label>التاريخ *</label><input type="date" name="expense_date" required></div>
        <div><label>الحساب المدفوع منه *</label><select name="account_id"><% accounts.forEach(a => { %><option value="<%= a.id %>"><%= a.name %></option><% }) %></select></div>
      </div>
      <label>ملاحظات (اختياري)</label><textarea name="notes" rows="2"></textarea>
      <button class="btn mt">حفظ المصروف</button>
    </form>
    <% if (canTypes) { %>
    <form method="post" action="/accounting/expense-types" class="flex mt">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input name="name" placeholder="نوع مصروف جديد..." style="max-width:220px">
      <button class="btn ghost sm">+ إضافة نوع</button>
    </form>
    <% } %>
  </div>
  <div class="card">
    <h2>ملاحظات</h2>
    <p class="muted">المصروف الفعلي يُخصم من رصيد الحساب المدفوع منه. التحويل بين الحسابات (مثلًا من الخزينة إلى البنك) ليس مصروفًا ويُسجل من صفحة التحويلات.</p>
  </div>
</div>
<div class="card">
  <h2>سجل المصروفات</h2>
  <table>
    <tr><th>التاريخ</th><th>النوع</th><th>القيمة</th><th>الحساب</th><th>سجلها</th><th>ملاحظات</th><th>الحالة</th><th></th></tr>
    <% rows.forEach(e => { %>
    <tr style="<%= e.status==='voided' ? 'opacity:.55' : '' %>">
      <td><%= new Date(e.expense_date).toLocaleDateString('ar-EG') %></td>
      <td><span class="badge teal"><%= e.type_name %></span></td>
      <td><b><%= Number(e.amount).toLocaleString('ar-EG') %></b></td>
      <td><%= e.account_name %></td><td class="muted"><%= e.recorded_by_name || '—' %></td>
      <td class="muted"><%= e.notes || '—' %></td>
      <td><span class="badge <%= e.status==='active'?'green':'red' %>"><%= e.status==='active'?'نشط':'ملغي' %></span>
        <% if (e.status==='voided') { %><br><span class="muted"><%= e.void_reason %> — <%= e.voided_by_name %></span><% } %></td>
      <td>
        <% if (canManage && e.status==='active') { %>
        <details><summary class="btn danger sm">إلغاء</summary>
          <form method="post" action="/accounting/expenses/<%= e.id %>/void" class="mt">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <input name="reason" placeholder="سبب الإلغاء *" required>
            <button class="btn danger sm mt">تأكيد</button>
          </form>
        </details>
        <% } %>
      </td>
    </tr>
    <% }) %>
    <% if (!rows.length) { %><tr><td colspan="8" class="muted">لا توجد مصروفات.</td></tr><% } %>
  </table>
</div>
<%- include('../partials/bottom') %>
