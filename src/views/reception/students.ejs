<%- include('../partials/top', {title, nav:'reception'}) %>
<div class="card">
  <form method="get" class="form-row" style="margin-bottom:12px">
    <div><label>بحث بالاسم أو رقم الهاتف</label><input name="q" value="<%= q %>" autofocus></div>
    <div><label>&nbsp;</label><button class="btn ghost">بحث</button></div>
  </form>
  <table>
    <tr><th>الاسم</th><th>الهاتف</th><th></th></tr>
    <% rows.forEach(r => { %><tr><td><%= r.name %></td><td dir="ltr"><%= r.phone %></td><td><a class="btn ghost sm" href="/reception/students/<%= r.id %>">الملف الكامل</a></td></tr><% }) %>
    <% if (q && !rows.length) { %><tr><td colspan="3" class="muted">لا توجد نتائج لطلاب مسجلين بكورسات.</td></tr><% } %>
  </table>
</div>
<%- include('../partials/bottom') %>
