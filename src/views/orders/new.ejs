<%- include('../partials/top', {title, nav:'orders'}) %>
<div class="card" style="max-width:860px">
  <h2>إنشاء حجز جديد</h2>
  <% if (error) { %><div class="alert err"><%= error %></div><% } %>
  <div class="alert info">الأسعار تُعتمد تلقائيًا من سعر الكورس أو الباقة المعتمدة، ولا يمكن لموظف المبيعات تغييرها أو إنشاء خصومات.</div>
  <form method="post" action="/orders">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <% if (lead) { %><input type="hidden" name="lead_id" value="<%= lead.id %>"><% } %>
    <div class="form-row">
      <div><label>اسم العميل *</label><input name="customer_name" required value="<%= lead ? lead.customer_name : '' %>" <%= lead ? 'readonly' : '' %>></div>
      <div><label>رقم الهاتف *</label><input name="customer_phone" required dir="ltr" value="<%= lead ? lead.customer_phone : '' %>" <%= lead ? 'readonly' : '' %>></div>
    </div>
    <div class="form-row">
      <div><label>نوع الحجز</label>
        <select name="kind" id="kind" onchange="document.getElementById('courseBox').style.display=this.value==='package'?'none':'block';document.getElementById('pkgBox').style.display=this.value==='package'?'block':'none'">
          <option value="course">كورس منفرد</option><option value="package">باقة</option>
        </select></div>
      <div id="courseBox"><label>الكورس</label>
        <select name="course_id" id="courseSel" onchange="updateGroups()">
          <% courses.forEach(c => { %><option value="<%= c.id %>" data-price="<%= c.base_price %>" <%= lead && lead.course_id===c.id ? 'selected' : '' %>><%= c.name %> — <%= Number(c.base_price).toLocaleString('ar-EG') %> ج.م</option><% }) %>
        </select></div>
      <div id="pkgBox" style="display:none"><label>الباقة</label>
        <select name="package_id" id="pkgSel" onchange="updateGroups()">
          <% packages.forEach(p => { %><option value="<%= p.id %>" data-price="<%= p.price %>" data-courses="<%= (p.course_ids||[]).join(',') %>"><%= p.name %> — <%= Number(p.price).toLocaleString('ar-EG') %> ج.م (<%= (p.course_names||[]).join(' + ') %>)</option><% }) %>
        </select></div>
    </div>
    <div id="groupsBox"></div>
    <div class="form-row">
      <div><label>طريقة الدفع</label>
        <select name="payment_type" id="payType" onchange="document.getElementById('instBox').style.display=this.value==='installments'?'block':'none'">
          <option value="cash">نقدي (كامل)</option><option value="installments">تقسيط</option>
        </select></div>
    </div>
    <div id="instBox" style="display:none" class="card" >
      <h2>خطة التقسيط</h2>
      <div class="form-row">
        <div><label>المقدم (ج.م)</label><input type="number" step="0.01" min="0" name="down_payment" value="0"></div>
        <div><label>عدد الأقساط</label><input type="number" min="1" name="installments_count"></div>
        <div><label>قيمة القسط (ج.م)</label><input type="number" step="0.01" min="0" name="installment_amount"></div>
        <div><label>تاريخ أول قسط</label><input type="date" name="first_due_date"></div>
      </div>
      <p class="muted">يجب أن يساوي المقدم + (قيمة القسط × العدد) إجمالي السعر تمامًا.</p>
    </div>
    <button class="btn orange mt">اعتماد الحجز</button>
  </form>
</div>
<script>
const groups = <%- JSON.stringify(groups.map(g => ({id:g.id, course_id:g.course_id, name:g.name, course_name:g.course_name, trainer_name:g.trainer_name, start_date:g.start_date, days:g.days_of_week, from:g.time_from?String(g.time_from).slice(0,5):'', to:g.time_to?String(g.time_to).slice(0,5):'', booked:Number(g.booked), capacity:g.capacity}))) %>;
function updateGroups() {
  const kind = document.getElementById('kind').value;
  let courseIds = [];
  if (kind === 'package') {
    const opt = document.getElementById('pkgSel').selectedOptions[0];
    courseIds = (opt.dataset.courses || '').split(',').filter(Boolean).map(Number);
  } else {
    courseIds = [parseInt(document.getElementById('courseSel').value, 10)];
  }
  const box = document.getElementById('groupsBox');
  box.innerHTML = courseIds.map(cid => {
    const gs = groups.filter(g => g.course_id === cid);
    const opts = gs.map(g => `<option value="${g.id}">${g.name} — ${g.course_name} (${g.trainer_name||'بدون مدرب'}) تبدأ ${g.start_date?String(g.start_date).slice(0,10):'—'} | ${g.days||''} ${g.from}-${g.to} | متاح ${g.capacity-g.booked}</option>`).join('');
    return `<div class="form-row"><div style="grid-column:1/-1"><label>مجموعة الكورس #${cid}</label>
      <select name="group_${cid}"><option value="">تحدد لاحقًا</option>${opts}</select></div></div>`;
  }).join('');
}
updateGroups();
</script>
<%- include('../partials/bottom') %>
