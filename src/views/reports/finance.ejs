<%- include('../partials/top', {title, nav:'reports'}) %>
<div class="card">
  <form method="get" class="form-row" style="margin-bottom:12px">
    <div><label>من</label><input type="date" name="from" value="<%= query.from || '' %>"></div>
    <div><label>إلى</label><input type="date" name="to" value="<%= query.to || '' %>"></div>
    <div><label>طريقة الدفع</label><select name="method"><option value="">الكل</option>
      <% Object.entries(L.paymentMethod).forEach(([k,v]) => { %><option value="<%= k %>" <%= query.method===k?'selected':'' %>><%= v %></option><% }) %></select></div>
    <div><label>نوع المصروف</label><select name="type_id"><option value="">الكل</option>
      <% types.forEach(t => { %><option value="<%= t.id %>" <%= String(query.type_id||'')===String(t.id)?'selected':'' %>><%= t.name %></option><% }) %></select></div>
    <div><label>&nbsp;</label><button class="btn ghost">تطبيق</button></div>
    <% if (canExport) { %><div><label>&nbsp;</label><button class="btn orange" name="format" value="csv">تصدير CSV</button></div><% } %>
  </form>
  <div class="grid c4" style="margin-bottom:14px">
    <div class="stat"><div class="num"><%= totalIn.toLocaleString('ar-EG') %></div><div class="lbl">إجمالي الإيرادات</div></div>
    <div class="stat orange"><div class="num"><%= totalOut.toLocaleString('ar-EG') %></div><div class="lbl">إجمالي المصروفات</div></div>
    <div class="stat"><div class="num"><%= (totalIn-totalOut).toLocaleString('ar-EG') %></div><div class="lbl">صافي الحركة</div></div>
    <div class="stat orange"><div class="num"><%= overdue.length %></div><div class="lbl">أقساط متأخرة</div></div>
  </div>
</div>
<div class="grid c2">
  <div class="card">
    <h2>الإيرادات (<%= payments.length %>)</h2>
    <table><tr><th>التاريخ</th><th>العميل</th><th>المبلغ</th><th>الطريقة</th><th>الحساب</th></tr>
      <% payments.slice(0,100).forEach(p => { %><tr><td class="muted"><%= new Date(p.paid_at).toLocaleDateString('ar-EG') %></td><td><%= p.customer_name %></td><td><%= Number(p.amount).toLocaleString('ar-EG') %></td><td><%= L.paymentMethod[p.method] %></td><td><%= p.account_name %></td></tr><% }) %>
      <% if (!payments.length) { %><tr><td colspan="5" class="muted">لا توجد إيرادات.</td></tr><% } %>
    </table>
  </div>
  <div class="card">
    <h2>المصروفات (<%= expenses.length %>)</h2>
    <table><tr><th>التاريخ</th><th>النوع</th><th>المبلغ</th><th>الحساب</th></tr>
      <% expenses.slice(0,100).forEach(e => { %><tr><td class="muted"><%= new Date(e.expense_date).toLocaleDateString('ar-EG') %></td><td><%= e.type_name %></td><td><%= Number(e.amount).toLocaleString('ar-EG') %></td><td><%= e.account_name %></td></tr><% }) %>
      <% if (!expenses.length) { %><tr><td colspan="4" class="muted">لا توجد مصروفات.</td></tr><% } %>
    </table>
    <h2 class="mt">أرصدة الحسابات</h2>
    <table><tr><th>الحساب</th><th>الرصيد</th></tr>
      <% balances.forEach(b => { %><tr><td><%= b.name %></td><td><b><%= Number(b.balance).toLocaleString('ar-EG') %></b></td></tr><% }) %>
    </table>
  </div>
</div>
<div class="card">
  <h2>الأقساط المتأخرة</h2>
  <table><tr><th>العميل</th><th>الهاتف</th><th>القيمة</th><th>الاستحقاق</th></tr>
    <% overdue.forEach(o => { %><tr><td><%= o.customer_name %></td><td dir="ltr"><%= o.phone %></td><td><span class="badge red"><%= Number(o.amount).toLocaleString('ar-EG') %></span></td><td class="muted"><%= new Date(o.due_date).toLocaleDateString('ar-EG') %></td></tr><% }) %>
    <% if (!overdue.length) { %><tr><td colspan="4" class="muted">لا توجد أقساط متأخرة.</td></tr><% } %>
  </table>
</div>
<%- include('../partials/bottom') %>
