<%- include('../partials/top', {title, nav:'courses'}) %>
<% if (can('courses.manage')) { %>
<div class="card">
  <h2>إضافة كورس</h2>
  <form method="post" action="/courses">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="form-row">
      <div><label>اسم الكورس *</label><input name="name" required></div>
      <div><label>السعر الأساسي (ج.م)</label><input type="number" step="0.01" min="0" name="base_price" value="0"></div>
      <div><label>المدة (أسابيع)</label><input type="number" min="0" name="duration_weeks"></div>
      <div><label>عدد المحاضرات</label><input type="number" min="0" name="lectures_count"></div>
    </div>
    <label>الوصف</label><textarea name="description" rows="2"></textarea>
    <button class="btn mt">حفظ الكورس</button>
  </form>
</div>
<% } %>
<div class="card">
  <h2>قائمة الكورسات</h2>
  <table>
    <tr><th>الاسم</th><th>السعر الأساسي</th><th>المدة</th><th>المحاضرات</th><th>مجموعات نشطة</th><th>الحالة</th><th></th></tr>
    <% rows.forEach(c => { %>
    <tr>
      <td><b><%= c.name %></b><br><span class="muted"><%= c.description || '' %></span></td>
      <td><%= Number(c.base_price).toLocaleString('ar-EG') %> ج.م</td>
      <td><%= c.duration_weeks ? c.duration_weeks + ' أسبوع' : '—' %></td>
      <td><%= c.lectures_count || '—' %></td><td><%= c.groups_count %></td>
      <td><span class="badge <%= c.status==='active'?'green':'gray' %>"><%= c.status==='active'?'نشط':'موقوف' %></span></td>
      <td>
        <% if (can('courses.manage')) { %>
        <details><summary class="btn ghost sm">تعديل</summary>
          <form method="post" action="/courses/<%= c.id %>/edit" class="mt">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <div class="form-row">
              <div><label>الاسم</label><input name="name" value="<%= c.name %>" required></div>
              <div><label>السعر</label><input type="number" step="0.01" min="0" name="base_price" value="<%= c.base_price %>"></div>
              <div><label>المدة</label><input type="number" min="0" name="duration_weeks" value="<%= c.duration_weeks || '' %>"></div>
              <div><label>المحاضرات</label><input type="number" min="0" name="lectures_count" value="<%= c.lectures_count || '' %>"></div>
              <div><label>الحالة</label><select name="status"><option value="active" <%= c.status==='active'?'selected':'' %>>نشط</option><option value="inactive" <%= c.status==='inactive'?'selected':'' %>>موقوف</option></select></div>
            </div>
            <label>الوصف</label><textarea name="description" rows="2"><%= c.description || '' %></textarea>
            <button class="btn sm mt">حفظ التعديل</button>
          </form>
        </details>
        <% } %>
      </td>
    </tr>
    <% }) %>
  </table>
</div>
<%- include('../partials/bottom') %>
