<%- include('../partials/top', {title, nav:'mycomm'}) %>
<% const STATUS = { pending: 'معلّقة', approved: 'معتمدة', paid: 'مدفوعة', cancelled: 'ملغاة' };
   const AR_MONTH = { '01':'يناير','02':'فبراير','03':'مارس','04':'أبريل','05':'مايو','06':'يونيو','07':'يوليو','08':'أغسطس','09':'سبتمبر','10':'أكتوبر','11':'نوفمبر','12':'ديسمبر' };
   const mk = (d) => { const s = new Date(d).toISOString().slice(0,7); return AR_MONTH[s.slice(5,7)] + ' ' + s.slice(0,4); }; %>
<div class="card">
  <h2>عمولتي</h2>
  <div class="grid c3 mt">
    <div class="stat"><div class="num"><%= Number(totals.pending || 0).toLocaleString('ar-EG') %></div><div class="lbl">معلّقة</div></div>
    <div class="stat"><div class="num"><%= Number(totals.approved || 0).toLocaleString('ar-EG') %></div><div class="lbl">معتمدة</div></div>
    <div class="stat"><div class="num"><%= Number(totals.paid || 0).toLocaleString('ar-EG') %></div><div class="lbl">مدفوعة</div></div>
  </div>
  <table class="mt cards-sm">
    <tr><th>الشهر</th><th>التارجت</th><th>فواتيرك</th><th>تحصيلاتك</th><th>العمولة</th><th>الحالة</th></tr>
    <% rows.forEach(cm => { %>
    <tr style="<%= cm.status === 'cancelled' ? 'opacity:.55' : '' %>">
      <td><b><%= mk(cm.month) %></b></td>
      <td><%= Number(cm.target).toLocaleString('ar-EG') %></td>
      <td><%= Number(cm.invoiced).toLocaleString('ar-EG') %><% if (!cm.eligible) { %><br><span class="muted">لم تبلغ نسبة الاستحقاق</span><% } %></td>
      <td><%= Number(cm.collected).toLocaleString('ar-EG') %></td>
      <td><b><%= Number(cm.amount).toLocaleString('ar-EG') %></b> ج.م</td>
      <td><span class="badge <%= cm.status === 'paid' ? 'green' : (cm.status === 'cancelled' ? 'red' : 'orange') %>"><%= STATUS[cm.status] %></span>
        <% if (cm.status === 'paid' && cm.paid_at) { %><br><span class="muted"><%= new Date(cm.paid_at).toLocaleDateString('ar-EG') %></span><% } %></td>
    </tr>
    <% }) %>
    <% if (!rows.length) { %><tr><td colspan="6" class="muted">لا توجد عمولات محتسبة لك بعد.</td></tr><% } %>
  </table>
  <p class="muted mt">تظهر هنا عمولاتك أنت فقط. تُحتسب شهريًا من فواتيرك وتحصيلاتك، وتُعتمد وتُصرف من قسم الحسابات.</p>
</div>
<%- include('../partials/bottom') %>
