<% if (user) { %>
    </div>
  </div>
</div>
<nav class="bottombar">
  <a href="/" class="<%= locals.nav==='dash'?'active':'' %>"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h5v-6h4v6h5V9.5"/></svg></span><span>الرئيسية</span></a>
  <% if (can('leads.view.own') || can('leads.view.all')) { %>
  <a href="/leads" class="<%= locals.nav==='leads'?'active':'' %>"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.2"/><path d="M2.5 20c.8-3.4 3.4-5 6.5-5s5.7 1.6 6.5 5"/><circle cx="17" cy="9" r="2.4"/><path d="M17.5 15.2c2.2.5 3.6 2 4 4.8"/></svg></span><span>العملاء</span></a>
  <% } %>
  <% if (can('leads.create')) { %>
  <a href="/leads/new" class="fab" aria-label="عميل جديد"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></span></a>
  <% } %>
  <a href="/notifications" class="<%= locals.nav==='notifications'?'active':'' %>"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 16H6c1.6-1.6 2.2-3.2 2.2-6.2a3.8 3.8 0 1 1 7.6 0c0 3 .6 4.6 2.2 6.2z"/><path d="M10 18.5a2.2 2.2 0 0 0 4 0"/></svg><% if ((locals.unreadCount||0)>0) { %><i class="bdot"><%= locals.unreadCount %></i><% } %></span><span>التنبيهات</span></a>
  <button type="button" id="navToggle2"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg></span><span>المزيد</span></button>
</nav>
<% } %>
<div class="nav-overlay" id="navOverlay"></div>
<script>
if ('serviceWorker' in navigator) {
  window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(() => {}));
}
(function () {
  var t = document.getElementById('navToggle');
  var t2 = document.getElementById('navToggle2');
  var o = document.getElementById('navOverlay');
  if (t) t.addEventListener('click', function () { document.body.classList.toggle('nav-open'); });
  if (t2) t2.addEventListener('click', function () { document.body.classList.toggle('nav-open'); });
  // الفلاتر تبدأ مطوية على الموبايل إلا إذا كانت مفعّلة
  if (window.matchMedia('(max-width:860px)').matches) {
    document.querySelectorAll('details.filters').forEach(function (d) { if (d.dataset.active !== '1') d.open = false; });
  }
  if (o) o.addEventListener('click', function () { document.body.classList.remove('nav-open'); });
  document.querySelectorAll('.sidebar nav a').forEach(function (a) {
    a.addEventListener('click', function () { document.body.classList.remove('nav-open'); });
  });
  // تحويل الجداول إلى بطاقات على الشاشات الصغيرة: نسخ عناوين الأعمدة إلى data-label
  document.querySelectorAll('table').forEach(function (tb) {
    if (tb.classList.contains('no-cards')) return;
    var headCells = tb.querySelectorAll('tr:first-child th');
    if (headCells.length < 3) return;
    var labels = [];
    headCells.forEach(function (th) { labels.push(th.textContent.trim()); });
    var rows = tb.querySelectorAll('tr');
    for (var i = 1; i < rows.length; i++) {
      var tds = rows[i].querySelectorAll('td');
      tds.forEach(function (td, j) { td.setAttribute('data-label', labels[j] || ''); });
    }
    tb.classList.add('cards-sm');
  });
})();
</script>
</body>
</html>
