<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %> | نظام كيان</title>
<link rel="icon" href="/static/img/logo.jpg">
<link rel="manifest" href="/static/manifest.webmanifest">
<meta name="theme-color" content="#006776">
<link rel="apple-touch-icon" href="/static/img/apple-touch-icon.png">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="كيان">
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/static/css/app.css?v=<%= assetV %>">
</head>
<body>
<% if (user) { const unread = (locals.unreadCount || 0); %>
<div class="layout">
  <aside class="sidebar">
    <div class="brand"><img src="/static/img/logo.jpg" alt="كيان"><b>نظام كيان</b></div>
    <nav>
      <a href="/" class="<%= locals.nav==='dash'?'active':'' %>"><span class="ic2"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h5v-6h4v6h5V9.5"/></svg></span> <span>لوحة التحكم</span></a>
      <% if (can('leads.view.own') || can('leads.view.all')) { %>
      <div class="section">المبيعات</div>
      <a href="/leads" class="<%= locals.nav==='leads'?'active':'' %>"><span class="ic2"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.2"/><path d="M2.5 20c.8-3.4 3.4-5 6.5-5s5.7 1.6 6.5 5"/><circle cx="17" cy="9" r="2.4"/><path d="M17.5 15.2c2.2.5 3.6 2 4 4.8"/></svg></span> <span>العملاء المحتملون</span></a>
      <% if (can('leads.assign')) { %><a href="/leads/distribution" class="<%= locals.nav==='dist'?'active':'' %>"><span class="ic2"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 3h5v5"/><path d="M4 20 21 3"/><path d="M21 16v5h-5"/><path d="m15 15 6 6"/><path d="M4 4l5 5"/></svg></span> <span>توزيع العملاء</span></a><% } %>
      <% if (can('leads.monitor')) { %><a href="/leads/monitor" class="<%= locals.nav==='monitor'?'active':'' %>"><span class="ic2"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="4" width="12" height="17" rx="2"/><path d="M9 4.5V3h6v1.5"/><path d="M9 10h6M9 14h6"/></svg></span> <span>متابعة الفريق</span></a><% } %>
      <a href="/orders" class="<%= locals.nav==='orders'?'active':'' %>"><span class="ic2"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 3h14v18l-2.5-1.5L14 21l-2-1.5L10 21l-2.5-1.5L5 21z"/><path d="M9 8h6M9 12h6"/></svg></span> <span>الحجوزات</span></a>
      <% } %>
      <% if (can('courses.view') || can('courses.manage') || can('groups.view') || can('groups.manage')) { %>
      <div class="section">الكورسات والمجموعات</div>
      <a href="/courses" class="<%= locals.nav==='courses'?'active':'' %>"><span class="ic2"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20V3H6.5A2.5 2.5 0 0 0 4 5.5z"/><path d="M4 19.5A2.5 2.5 0 0 0 6.5 22H20v-5"/></svg></span> <span>الكورسات</span></a>
      <a href="/groups" class="<%= locals.nav==='groups'?'active':'' %>"><span class="ic2"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/><circle cx="8.5" cy="14.5" r="1"/><circle cx="12" cy="14.5" r="1"/><circle cx="15.5" cy="14.5" r="1"/></svg></span> <span>المجموعات</span></a>
      <a href="/packages" class="<%= locals.nav==='packages'?'active':'' %>"><span class="ic2"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="9" width="16" height="4"/><path d="M6 13v8h12v-8"/><path d="M12 9v12"/><path d="M12 9s-4.5.3-4.5-2.2C7.5 4.6 10.5 4 12 9zM12 9s4.5.3 4.5-2.2C16.5 4.6 13.5 4 12 9z"/></svg></span> <span>الباقات</span></a>
      <% if (can('trainers.manage')) { %><a href="/trainers" class="<%= locals.nav==='trainers'?'active':'' %>"><span class="ic2"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m2 9 10-5 10 5-10 5z"/><path d="M6 11.5V16c0 1.5 2.7 3 6 3s6-1.5 6-3v-4.5"/><path d="M22 9v5"/></svg></span> <span>المدربون</span></a><% } %>
      <% } %>
      <% if (can('payments.view') || can('payments.create') || can('expenses.view') || can('accounts.view')) { %>
      <div class="section">الحسابات</div>
      <a href="/accounting" class="<%= locals.nav==='accounting'?'active':'' %>"><span class="ic2"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="9" r="6"/><path d="M14.5 5.5A6 6 0 1 1 9 15.8"/><path d="M7 9h4M9 7v4"/></svg></span> <span>الحسابات</span></a>
      <a href="/accounting/payments" class="<%= locals.nav==='payments'?'active':'' %>"><span class="ic2"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 10h18"/><path d="M7 15h4"/></svg></span> <span>المدفوعات</span></a>
      <a href="/accounting/installments" class="<%= locals.nav==='installments'?'active':'' %>"><span class="ic2"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/><path d="M8 15h3"/></svg></span> <span>الأقساط</span></a>
      <a href="/accounting/expenses" class="<%= locals.nav==='expenses'?'active':'' %>"><span class="ic2"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M8 7h8"/><path d="M8 12h.01M12 12h.01M16 12h.01M8 16h.01M12 16h.01M16 16h.01"/></svg></span> <span>المصروفات</span></a>
      <% } %>
      <% if (can('reception.view')) { %>
      <div class="section">الاستقبال</div>
      <a href="/reception" class="<%= locals.nav==='reception'?'active':'' %>"><span class="ic2"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 17h16"/><path d="M6 17a6 6 0 0 1 12 0"/><path d="M12 11V8"/><path d="M10 8h4"/><path d="M9 20h6"/></svg></span> <span>لوحة الاستقبال</span></a>
      <% } %>
      <% if (can('reports.sales') || can('reports.finance')) { %>
      <div class="section">التقارير</div>
      <a href="/reports" class="<%= locals.nav==='reports'?'active':'' %>"><span class="ic2"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20V10"/><path d="M10 20V4"/><path d="M16 20v-7"/><path d="M22 20H2"/></svg></span> <span>التقارير</span></a>
      <% } %>
      <div class="section">عام</div>
      <a href="/assistant" class="<%= locals.nav==='assistant'?'active':'' %>"><span class="ic2"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="8" width="14" height="10" rx="2"/><path d="M12 8V4"/><circle cx="12" cy="3" r="1"/><circle cx="10" cy="13" r="1"/><circle cx="14" cy="13" r="1"/><path d="M9 18v2M15 18v2"/></svg></span> <span>مساعد كيان</span></a>
      <% if (can('users.manage') || can('users.request')) { %><a href="/admin/users" class="<%= locals.nav==='users'?'active':'' %>"><span class="ic2"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.5"/><path d="M5 20c1-3.5 3.5-5 7-5s6 1.5 7 5"/></svg></span> <span>المستخدمون</span></a><% } %>
      <% if (can('audit.view')) { %><a href="/admin/audit" class="<%= locals.nav==='audit'?'active':'' %>"><span class="ic2"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="6"/><path d="m20 20-3.8-3.8"/><path d="M8.5 11h5"/></svg></span> <span>سجل المراجعة</span></a><% } %>
      <% if (can('settings.manage')) { %>
      <a href="/admin/settings" class="<%= locals.nav==='settings'?'active':'' %>"><span class="ic2"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M2 12h3M19 12h3M4.9 19.1 7 17M17 7l2.1-2.1"/></svg></span> <span>الإعدادات</span></a>
      <a href="/automation" class="<%= locals.nav==='automation'?'active':'' %>"><span class="ic2"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4 14h6l-1 8 9-12h-6z"/></svg></span> <span>الأتمتة</span></a>
      <% } %>
    </nav>
    <div class="who">
      <b><%= user.name %></b>
      <span class="details" style="color:var(--teal-200)"><%= ({admin:'مدير النظام',general_supervisor:'المشرف العام',sales_manager:'مدير المبيعات',sales_team_leader:'تيم ليدر المبيعات',sales_staff:'موظف مبيعات',accounting_manager:'مدير الحسابات',accounting_staff:'موظف حسابات',reception:'استقبال',course_manager:'مسؤول الكورسات'})[user.role] || user.role %></span>
      <form method="post" action="/logout" class="mt"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn ghost sm" style="width:100%">تسجيل الخروج</button></form>
    </div>
  </aside>
  <div class="main">
    <div class="topbar">
      <button class="burger" id="navToggle" aria-label="القائمة">☰</button>
      <h1><%= title %></h1>
      <a class="bell" href="/notifications" aria-label="التنبيهات"><svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 16H6c1.6-1.6 2.2-3.2 2.2-6.2a3.8 3.8 0 1 1 7.6 0c0 3 .6 4.6 2.2 6.2z"/><path d="M10 18.5a2.2 2.2 0 0 0 4 0"/></svg><% if (unread>0) { %><span class="dot"><%= unread %></span><% } %></a>
    </div>
    <div class="content">
<% } %>
